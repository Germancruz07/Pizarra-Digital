# Copia este archivo como ".env" y rellena los valores. ".env" está en .gitignore.
#
# IMPORTANTE: Vite incrusta en el JavaScript del navegador TODA variable que empiece por VITE_.
# Úsalas solo para claves "públicas" pensadas para el cliente (p. ej. la anon key de Supabase o
# la config web de Firebase, protegidas por RLS / reglas de seguridad).
# Las claves secretas (service_role, OpenAI, Stripe secret…) NUNCA deben llevar el prefijo VITE_:
# van en un backend o función serverless que la app llame.

# Supabase (cliente)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase (cliente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
